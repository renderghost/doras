{
  "name": "doras",
  "private": true,
  "description": "The design system for creating an Atmosphere account and signing in with one.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renderghost/doras.git"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "eslint . && stylelint \"**/*.css\" --allow-empty-input",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
