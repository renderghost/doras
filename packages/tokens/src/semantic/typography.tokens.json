  "type": {
    "$type": "typography",
    "heading": {
      "lg": {
        "$value": {
          "fontFamily": "{primitive.font.family.sans}",
          "fontSize": "{primitive.font.size.24}",
          "fontWeight": "{primitive.font.weight.bold}",
          "letterSpacing": "{primitive.font.letter-spacing.tighter}",
          "lineHeight": "{primitive.font.line-height.tight}"
        },
        "$description": "Page titles on provider pages."
      },
      "md": {
        "$value": {
          "fontFamily": "{primitive.font.family.sans}",
          "fontSize": "{primitive.font.size.20}",
          "fontWeight": "{primitive.font.weight.bold}",
          "letterSpacing": "{primitive.font.letter-spacing.tight}",
          "lineHeight": "{primitive.font.line-height.tight}"
        },
        "$description": "Sheet titles."
      },
      "sm": {
        "$value": {
          "fontFamily": "{primitive.font.family.sans}",
          "fontSize": "{primitive.font.size.17}",
          "fontWeight": "{primitive.font.weight.semibold}",
          "letterSpacing": "{primitive.font.letter-spacing.none}",
          "lineHeight": "{primitive.font.line-height.snug}"
        },
        "$description": "Section headings."
      }
    },
    "body": {
      "lg": {
        "$value": {
          "fontFamily": "{primitive.font.family.sans}",
          "fontSize": "{primitive.font.size.17}",
