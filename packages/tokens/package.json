{
  "name": "@doras/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens in the DTCG 2025.10 format, built for CSS, Swift and Kotlin.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renderghost/doras.git",
    "directory": "packages/tokens"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/css/doras.css",
    "./tokens.json": "./dist/tokens.json",
    "./swift/*": "./dist/swift/*",
    "./kotlin/*": "./dist/kotlin/*",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/check-no-mocks.ts && node build/index.ts"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "style-dictionary": "5.8.0"
  }
}
